{
  "version": "1.0.0",
  "name": "agent-web-template",
  "description": "Astro + TypeScript 7 + Bun + Decap CMS + Fancybox starter for client websites on Cloudflare Pages (Resend e-mail, in-repo AVIF image sets).",
  "private": true,
  "type": "module",
  "license": "UNLICENSED",
  "dependencies": {
    "@fancyapps/ui": "^6.1.15",
    "marked": "^18.1.1",
    "tailwind-merge": "^3.7.0",
    "tailwind-variants": "^3.3.1"
  },
  "keywords": [],
  "author": "Lukáš Chylík",
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@tailwindcss/cli": "^4.3.3",
    "@types/node": "^24.19.2",
    "astro": "^7.4.0",
    "decap-server": "^3.11.5",
    "npm-run-all": "^4.1.5",
    "sharp": "^0.35.5",
    "smartcrop-sharp": "2.0.8",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-7": "npm:typescript@^7.0.2"
  },
  "scripts": {
    "dev": "run-p css:dev astro:dev",
    "start": "bun run dev",
    "build": "bun run css:build && bun run typecheck && astro build",
    "preview": "astro preview",
    "astro": "astro",
    "astro:dev": "astro dev",
    "css:dev": "tailwindcss -i public/styles/tailwind.source.css -o public/styles/tailwind.css --watch",
    "css:build": "tailwindcss -i public/styles/tailwind.source.css -o public/styles/tailwind.css --minify",
    "icons": "bun scripts/generate-icons.ts",
    "cms:local": "decap-server",
    "image-set": "bun scripts/image-set.ts",
    "typecheck": "astro check && node node_modules/typescript-7/bin/tsc --noEmit",
    "placeholders": "bun scripts/placeholders.ts"
  },
  "engines": {
    "node": ">=24.0.0",
    "bun": ">=1.4.0"
  },
  "packageManager": "bun@1.4.3"
}
