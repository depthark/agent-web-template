---
/**
 * Home – "Špecimen" (docs/creative/brief.md): the site as a type specimen of
 * modern CSS. Each plate demonstrates the feature it names, on real content.
 */
import BaseLayout from "@/layouts/BaseLayout.astro";
import SiteHeader from "@/components/SiteHeader.astro";
import SiteFooter from "@/components/SiteFooter.astro";
import Button from "@/components/ui/Button.astro";
import Plate from "@/components/specimen/Plate.astro";
import SpecimenHero from "@/components/specimen/SpecimenHero.astro";
import SystemCells from "@/components/specimen/SystemCells.astro";
import GamutPlate from "@/components/specimen/GamutPlate.astro";
import Colophon from "@/components/specimen/Colophon.astro";
import { site } from "@/data/site";
import { faqPage } from "@/lib/structured-data";
import { withBase } from "@/lib/navigation";

const { seo, hero, features, faq, cta, plates } = site.home;

// CSS identifiers for the services-as-layers plate: first word, no diacritics.
const layerName = (title: string) =>
  title.split(" ")[0]!.normalize("NFD").replace(/[̀-ͯ]/g, "").toLowerCase();
const layers = features.items.map((item) => ({ ...item, layer: layerName(item.title) }));

// "2025-10" → "10/2025"
const monthYear = (date: string) => date.split("-").reverse().join("/");

const index = [
  { id: "system", no: "01", title: "Systém" },
  { id: "vrstvy", no: "02", title: "Vrstvy" },
  { id: "texty", no: "03", title: "Texty" },
  { id: "podium", no: "04", title: "Pódium" },
  { id: "farba", no: "05", title: "Farba" },
  { id: "nastroje", no: "06", title: "Nástroje" },
  { id: "tiraz", no: "—", title: "Tiráž" },
];
---

<BaseLayout
  title={seo.title}
  description={seo.description}
  keywords={seo.keywords}
  pathname="/"
  imageAlt={hero.imageAlt || undefined}
  schema={faq.length ? [faqPage()] : []}
>
  <SiteHeader pathname={Astro.url.pathname} />
  <main id="main" class="page">
    <SpecimenHero />

    <nav class="contents" aria-labelledby="obsah-title">
      <h2 id="obsah-title" class="contents__title">Obsah</h2>
      <ol class="contents__list">
        {
          index.map((entry) => (
            <li>
              <a href={`#${entry.id}`} class="contents__link">
                <span class="contents__no" aria-hidden="true">{entry.no}</span>
                <span>{entry.title}</span>
              </a>
            </li>
          ))
        }
      </ol>
    </nav>

    <Plate id="system" number="01" title={plates.system.title} feature="@property + view()" baseline="obmedzená (scroll-driven)">
      <div class="system-stats">
        <p><span class="stat">{plates.system.components}</span> <span class="stat__label">komponentov</span></p>
        <p><span class="stat">{plates.system.variables}</span> <span class="stat__label">dizajnových premenných</span></p>
      </div>
      <p class="lead">{plates.system.text}</p>
      <div class="mt-8"><SystemCells count={plates.system.components} /></div>
      <p class="mt-8"><a class="text-link" href={withBase(plates.system.href)}>Viac o VIGo</a></p>
    </Plate>

    <Plate id="vrstvy" number="02" title={features.title} feature="@layer" baseline="široko dostupné">
      <p class="layers__decl"><code>@layer {layers.map((l) => l.layer).join(", ")};</code></p>
      <ol class="layers">
        {
          layers.map((item, i) => (
            <li class="layer" style={`--i: ${i}`}>
              <p class="layer__name"><code>@layer {item.layer}</code></p>
              <h3 class="layer__title">{item.title}</h3>
              <p class="layer__text">{item.text}</p>
            </li>
          ))
        }
      </ol>
    </Plate>

    <Plate id="texty" number="03" title={plates.writing.title} feature="animation-timeline: view()" baseline="obmedzená dostupnosť">
      <ul class="rows">
        {
          plates.writing.items.map((item, i) => (
            <li class="row" data-reveal style={`--reveal-i: ${i}`}>
              <span class="row__meta">{item.year}</span>
              <a class="row__link" href={item.href}>{item.title}</a>
            </li>
          ))
        }
      </ul>
      <p class="mt-8"><a class="text-link" href={plates.writing.moreHref}>{plates.writing.moreLabel}</a></p>
    </Plate>

    <Plate id="podium" number="04" title={plates.talks.title} feature="container-type: scroll-state" baseline="obmedzená dostupnosť">
      <p slot="margin" class="podium-note">Popis tabule je sám ukážkou: na širšej obrazovke sa pripne a prepne na <code>stuck: top</code>.</p>
      {plates.talks.text && <p class="lead">{plates.talks.text}</p>}
      <ul class="rows mt-8">
        {
          plates.talks.items.map((item, i) => (
            <li class="row row--talk" data-reveal style={`--reveal-i: ${i}`}>
              <span class="row__meta"><time datetime={item.date}>{monthYear(item.date)}</time></span>
              <span class="row__event">{item.event} <span class="row__place">· {item.place}</span></span>
              <span class="row__topic">{item.title}</span>
            </li>
          ))
        }
      </ul>
    </Plate>

    <Plate id="farba" number="05" title={plates.color.title} feature="oklch() + <canvas>" baseline="široko dostupné">
      <p slot="margin" class="podium-note">Jediná výnimka z „najprv CSS": 2 kB WebGL. Bez neho tu ostane CSS gradient v <code>oklch</code>.</p>
      <p class="lead">{plates.color.text}</p>
      <div class="mt-8"><GamutPlate /></div>
      <p class="mt-8"><a class="text-link" href={plates.color.href}>{plates.color.linkLabel}</a></p>
    </Plate>

    <Plate id="nastroje" number="06" title={plates.tools.title} feature="@supports" baseline="široko dostupné">
      <ul class="tools">
        {
          plates.tools.items.map((tool) => (
            <li class="tool">
              <p class="tool__kind">{tool.kind}</p>
              <h3 class="tool__name">
                <a href={withBase(tool.href)} class="tool__link">{tool.name}</a>
              </h3>
              <p class="tool__text">{tool.text}</p>
            </li>
          ))
        }
      </ul>
    </Plate>

    <Colophon />

    <section class="closing" aria-labelledby="cta-title">
      <p class="closing__eyebrow">{cta.eyebrow}</p>
      <h2 id="cta-title" class="closing__title">{cta.title}</h2>
      <Button as="a" href={withBase(cta.href)} variant="primary" size="lg" rel={undefined} class="mt-8 w-full sm:w-auto">
        {cta.label}
      </Button>
    </section>
  </main>
  <SiteFooter />
</BaseLayout>

<style>
  .page {
    max-inline-size: 90rem;
    margin-inline: auto;
    padding-inline: clamp(1rem, 4vw, 3rem);
  }

  /* Obsah – Sutnar-style index: numbers carry the rhythm. */
  .contents {
    padding-block: clamp(2.5rem, 6vw, 4.5rem);
    border-block-start: 1px solid var(--color-border-strong);
  }

  .contents__title {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0;
    color: var(--color-primary);
  }

  .contents__list {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(10rem, 1fr));
    gap: 0 1.5rem;
    margin-block-start: 1rem;
    list-style: none;
    padding: 0;
  }

  .contents__link {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    min-block-size: 2.75rem;
    padding-block: 0.6rem;
    border-block-end: 1px solid var(--color-border);
    font-family: var(--font-heading);
    font-size: 1.25rem;
    font-variation-settings: "wdth" 112;
    font-weight: 600;
    color: var(--color-foreground);
    text-decoration: none;
  }

  .contents__link:hover,
  .contents__link:focus-visible {
    color: var(--color-primary);
  }

  .contents__no {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 400;
    color: var(--color-subtle);
  }

  .lead {
    max-inline-size: 62ch;
    margin-block-start: 1.5rem;
    font-size: 1.0625rem;
    line-height: 1.7;
    color: var(--color-muted);
    text-wrap: pretty;
  }

  .text-link,
  .row__link,
  .tool__link {
    color: var(--color-foreground);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.22em;
    transition:
      color var(--duration-fast) var(--ease-set),
      text-decoration-thickness var(--duration-fast) var(--ease-set);
  }

  .text-link {
    display: inline-flex;
    align-items: center;
    min-block-size: 2.75rem;
    font-family: var(--font-mono);
    font-size: 0.875rem;
  }

  .text-link::after {
    content: "→";
    margin-inline-start: 0.5em;
    text-decoration: none;
  }

  .text-link:hover,
  .text-link:focus-visible,
  .row__link:hover,
  .row__link:focus-visible,
  .tool__link:hover,
  .tool__link:focus-visible {
    color: var(--color-primary);
    text-decoration-thickness: 2px;
  }

  /* Tab. 01 */
  .system-stats {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem 3rem;
    margin-block-start: 2rem;
  }

  .stat {
    display: block;
    font-family: var(--font-heading);
    font-size: clamp(3.5rem, 9vw, 7rem);
    font-variation-settings: "wdth" 150;
    font-weight: 800;
    line-height: 0.9;
    font-variant-numeric: tabular-nums;
  }

  .stat__label {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--color-muted);
  }

  /* Tab. 02 – services stacked like cascade layers: later layers win, so
     they sit on top and step to the right. */
  .layers__decl {
    margin-block-start: 1.5rem;
    font-size: 0.875rem;
    color: var(--color-muted);
  }

  .layers {
    display: grid;
    gap: 1rem;
    margin-block-start: 1.5rem;
    padding: 0;
    list-style: none;
  }

  .layer {
    position: relative;
    z-index: var(--i);
    max-inline-size: 36rem;
    padding: 1.5rem;
    background: var(--color-surface-elevated);
    border: 1px solid var(--color-border-strong);
    box-shadow: 0 1px 0 var(--color-border);
  }

  .layer__name {
    font-size: 0.75rem;
    color: var(--color-primary);
  }

  .layer__title {
    margin-block-start: 0.5rem;
    font-size: clamp(1.375rem, 2.5vw, 1.875rem);
    font-variation-settings: "wdth" 110;
    font-weight: 700;
    line-height: 1.1;
  }

  .layer__text {
    margin-block-start: 0.6rem;
    line-height: 1.65;
    color: var(--color-muted);
  }

  @media (min-width: 48rem) {
    .layers {
      gap: 0;
    }

    .layer {
      margin-inline-start: calc(var(--i) * clamp(2rem, 6vw, 6rem));
    }

    .layer + .layer {
      margin-block-start: -1.25rem;
    }
  }

  /* Tab. 03 + 04 – rows */
  .rows {
    margin-block-start: 1.5rem;
    padding: 0;
    list-style: none;
    border-block-start: 1px solid var(--color-border);
  }

  .row {
    display: grid;
    grid-template-columns: 5.5rem minmax(0, 1fr);
    gap: 0.25rem 1rem;
    align-items: baseline;
    padding-block: 1rem;
    border-block-end: 1px solid var(--color-border);
  }

  .row__meta {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--color-subtle);
  }

  .row__link {
    font-family: var(--font-heading);
    font-size: clamp(1.25rem, 2.6vw, 1.875rem);
    font-variation-settings: "wdth" 105;
    font-weight: 600;
    line-height: 1.15;
  }

  .row--talk .row__event {
    font-family: var(--font-heading);
    font-size: clamp(1.25rem, 2.6vw, 1.75rem);
    font-variation-settings: "wdth" 120;
    font-weight: 700;
    line-height: 1.15;
  }

  .row__place {
    font-weight: 400;
    color: var(--color-muted);
  }

  .row__topic {
    grid-column: 2;
    color: var(--color-muted);
    line-height: 1.55;
  }

  .podium-note {
    flex-basis: 100%;
    max-inline-size: 15rem;
    margin-block-start: 0.5rem;
    color: var(--color-muted);
    line-height: 1.55;
  }

  /* Tab. 06 */
  .tools {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
    gap: 1.5rem;
    margin-block-start: 2rem;
    padding: 0;
    list-style: none;
  }

  .tool {
    padding-block-start: 1rem;
    border-block-start: 2px solid var(--color-foreground);
  }

  .tool__kind {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--color-primary);
  }

  .tool__name {
    margin-block-start: 0.5rem;
    font-family: var(--font-mono);
    font-size: 1.25rem;
    font-weight: 600;
    letter-spacing: 0;
  }

  .tool__link {
    display: inline-flex;
    min-block-size: 2.75rem;
    align-items: center;
  }

  .tool__text {
    margin-block-start: 0.25rem;
    line-height: 1.65;
    color: var(--color-muted);
  }

  /* Closing */
  .closing {
    padding-block: clamp(4rem, 10vw, 8rem);
    border-block-start: 1px solid var(--color-border-strong);
  }

  .closing__eyebrow {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--color-primary);
  }

  .closing__title {
    margin-block-start: 1rem;
    max-inline-size: 15.2em; /* em, not ch: ch changes with the font (swap) */
    font-size: clamp(2.25rem, 6.5vw, 5.5rem);
    font-variation-settings: "wdth" 120;
    font-weight: 800;
    line-height: 0.98;
    letter-spacing: -0.03em;
    text-wrap: balance;
  }
</style>
