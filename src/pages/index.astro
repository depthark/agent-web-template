---
import BaseLayout from "@/layouts/BaseLayout.astro";
import SiteHeader from "@/components/SiteHeader.astro";
import SiteFooter from "@/components/SiteFooter.astro";
import HeroSection from "@/components/HeroSection.astro";
import SectionIntro from "@/components/SectionIntro.astro";
import FaqSection from "@/components/FaqSection.astro";
import Button from "@/components/ui/Button.astro";
import ArrowRightIcon from "@/components/icons/ArrowRightIcon.astro";
import SparklesIcon from "@/components/icons/SparklesIcon.astro";
import { site } from "@/data/site";
import { heroPreload } from "@/lib/images";
import { faqPage } from "@/lib/structured-data";
import { withBase } from "@/lib/navigation";

const { seo, hero, features, faq, cta } = site.home;
---

<BaseLayout
  title={seo.title}
  description={seo.description}
  keywords={seo.keywords}
  pathname="/"
  imageAlt={hero.imageAlt}
  preload={heroPreload()}
  schema={faq.length ? [faqPage()] : []}
>
  <SiteHeader pathname={Astro.url.pathname} />
  <main id="main">
    <HeroSection />

    <section
      id="obsah"
      class="mx-auto max-w-7xl px-4 py-14 sm:px-6 sm:py-20 lg:px-8 lg:py-28"
      aria-labelledby="features-title"
    >
      <SectionIntro eyebrow={features.eyebrow} title={features.title} align="center" headingId="features-title" />
      <!-- Not links: no hover effect, so nothing suggests a click. -->
      <ul class="mt-10 grid list-none gap-6 sm:mt-14 md:grid-cols-3">
        {
          features.items.map((item, index) => (
            <li class="flex h-full flex-col rounded-xl border border-border bg-surface p-6" data-reveal style={`--reveal-i: ${index}`}>
              <span class="inline-flex h-11 w-11 items-center justify-center rounded-full bg-primary/10 text-primary">
                <SparklesIcon class="h-5 w-5" />
              </span>
              <h3 class="mt-5 text-xl text-foreground">{item.title}</h3>
              <p class="mt-3 leading-7 text-muted">{item.text}</p>
            </li>
          ))
        }
      </ul>
    </section>

    {faq.length > 0 && <FaqSection items={faq} />}

    <section
      class="cta-glow relative isolate overflow-hidden border-y border-border bg-surface-elevated py-14 text-foreground sm:py-20 lg:py-24"
      aria-labelledby="cta-title"
    >
      <div
        class="mx-auto flex max-w-7xl flex-col items-start justify-between gap-8 px-4 sm:px-6 lg:flex-row lg:items-center lg:px-8"
        data-reveal
      >
        <div class="max-w-3xl space-y-4">
          <p class="text-sm font-medium uppercase tracking-eyebrow text-primary">{cta.eyebrow}</p>
          <h2 id="cta-title" class="text-2xl leading-tight sm:text-3xl md:text-5xl">{cta.title}</h2>
        </div>
        <Button as="a" href={withBase(cta.href)} variant="primary" size="lg" fullWidth rel={undefined} class="lg:w-auto">
          {cta.label}
          <ArrowRightIcon class="h-5 w-5" />
        </Button>
      </div>
    </section>
  </main>
  <SiteFooter />
</BaseLayout>

<style>
  /* Final CTA: soft brand light behind the copy (accent only). */
  .cta-glow::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      radial-gradient(
        ellipse 55% 90% at 0% 100%,
        color-mix(in oklch, var(--color-primary) 12%, transparent),
        transparent 70%
      ),
      radial-gradient(
        ellipse 45% 80% at 100% 0%,
        color-mix(in oklch, var(--color-accent) 12%, transparent),
        transparent 70%
      );
    pointer-events: none;
  }
</style>
