---
/**
 * Home – "Špecimen" (docs/creative/brief.md): the site as a type specimen of
 * modern CSS. Each plate demonstrates the feature it names, on real content.
 */
import BaseLayout from "@/layouts/BaseLayout.astro";
import SiteHeader from "@/components/SiteHeader.astro";
import SiteFooter from "@/components/SiteFooter.astro";
import Plate from "@/components/specimen/Plate.astro";
import SpecimenHero from "@/components/specimen/SpecimenHero.astro";
import SystemCells from "@/components/specimen/SystemCells.astro";
import GamutPlate from "@/components/specimen/GamutPlate.astro";
import Colophon from "@/components/specimen/Colophon.astro";
import Closing from "@/components/specimen/Closing.astro";
import { site } from "@/data/site";
import { faqPage } from "@/lib/structured-data";
import { withBase } from "@/lib/navigation";

const { seo, hero, features, faq, plates } = site.home;

// Tab. 02 runs on real cascade layers: one layer per service (CSS identifiers
// may contain diacritics). Each layer styles every card with a selector less
// specific than the one before – and the last layer still wins, which each
// card prints. Generated from the CMS titles at build time.
const layerName = (title: string) => title.split(" ")[0]!.toLowerCase().replace(/[^\p{L}\p{N}-]/gu, "");
const layers = features.items.map((item) => ({ ...item, layer: layerName(item.title) }));
const layerSelectors = ["#vrstvy .layers .layer", ".layers .layer", ".layer"];
const layerCss = [
  `@layer ${layers.map((l) => l.layer).join(", ")};`,
  ...layers.map(
    (l, i) =>
      `@layer ${l.layer} { ${layerSelectors[Math.min(i, layerSelectors.length - 1)]} { --winner: "@layer ${l.layer}"; border-color: ${i === layers.length - 1 ? "var(--color-primary)" : "var(--color-border-strong)"}; } }`,
  ),
].join("\n");

// Tab. 06 runs on @supports: features this page uses, each with a CSS-only
// readout of the visitor's own browser.
const supports = [
  { id: "sd", label: "animation-timeline: view()", test: "(animation-timeline: view())", where: "Tab. 00, 01, 03", no: "animácie stoja, obsah je celý" },
  { id: "ss", label: "container-type: scroll-state", test: "(container-type: scroll-state)", where: "Tab. 04", no: "štítok tabule sa nemení" },
  { id: "vt", label: "view-transition-name", test: "(view-transition-name: a)", where: "prechody stránok", no: "stránky sa prepnú bez prechodu" },
  { id: "ok", label: "color: oklch()", test: "(color: oklch(0.5 0.1 30))", where: "celá paleta", no: "farby webu sa nezobrazia správne" },
  { id: "tw", label: "text-wrap: pretty", test: "(text-wrap: pretty)", where: "odstavce", no: "riadky sa zalomia bežne" },
];
const supportsCss = supports
  .map((f) => `@supports ${f.test} { .support[data-f="${f.id}"] .support__yes { display: inline; } .support[data-f="${f.id}"] .support__no { display: none; } }`)
  .join("\n");

// "2025-10" → "10/2025"
const monthYear = (date: string) => date.split("-").reverse().join("/");

const index = [
  { id: "system", no: "01", title: "Systém" },
  { id: "vrstvy", no: "02", title: "Vrstvy" },
  { id: "texty", no: "03", title: "Texty" },
  { id: "podium", no: "04", title: "Pódium" },
  { id: "farba", no: "05", title: "Farba" },
  { id: "nastroje", no: "06", title: "Nástroje" },
  { id: "tiraz", no: "—", title: "Tiráž" },
];
---

<BaseLayout
  title={seo.title}
  description={seo.description}
  keywords={seo.keywords}
  pathname="/"
  imageAlt={hero.imageAlt || undefined}
  schema={faq.length ? [faqPage()] : []}
>
  <SiteHeader pathname={Astro.url.pathname} />
  <main id="main" class="page">
    <SpecimenHero />

    <nav class="contents" aria-labelledby="obsah-title">
      <h2 id="obsah-title" class="contents__title">Obsah</h2>
      <ol class="contents__list">
        {
          index.map((entry) => (
            <li>
              <a href={`#${entry.id}`} class="contents__link">
                <span class="contents__no" aria-hidden="true">{entry.no}</span>
                <span>{entry.title}</span>
              </a>
            </li>
          ))
        }
      </ol>
    </nav>

    <Plate id="system" number="01" title={plates.system.title} feature="@property + view()" baseline="obmedzená (scroll-driven)">
      <div class="system-stats">
        <p><span class="stat">{plates.system.components}</span> <span class="stat__label">komponentov</span></p>
        <p><span class="stat">{plates.system.variables}</span> <span class="stat__label">dizajnových premenných</span></p>
      </div>
      <p class="lead">{plates.system.text}</p>
      <div class="mt-8"><SystemCells count={plates.system.components} /></div>
      <p class="mt-8"><a class="text-link" href={withBase(plates.system.href)}>Viac o VIGo</a></p>
    </Plate>

    <Plate id="vrstvy" number="02" title={features.title} feature="@layer" baseline="široko dostupné">
      <style is:inline set:html={layerCss}></style>
      <p class="layers__decl"><code>@layer {layers.map((l) => l.layer).join(", ")};</code></p>
      <p class="layers__note">
        Každá vrstva farbí všetky karty – s čoraz slabším selektorom, od <code>{layerSelectors[0]}</code> po <code>{layerSelectors[2]}</code>. Aj tak vyhrá posledná vrstva: poradie vrstiev je silnejšie než špecificita. Karty to vypisujú samy.
      </p>
      <ol class="layers">
        {
          layers.map((item, i) => (
            <li class="layer" style={`--i: ${i}`}>
              <p class="layer__name"><code>@layer {item.layer}</code></p>
              <h3 class="layer__title">{item.title}</h3>
              <p class="layer__text">{item.text}</p>
              <p class="layer__winner" aria-hidden="true">border-color ← <span class="layer__winner-value"></span></p>
            </li>
          ))
        }
      </ol>
    </Plate>

    <Plate id="texty" number="03" title={plates.writing.title} feature="animation-timeline: view()" baseline="obmedzená dostupnosť">
      <ul class="rows">
        {
          plates.writing.items.map((item, i) => (
            <li class="row" data-reveal style={`--reveal-i: ${i}`}>
              <span class="row__meta">{item.year}</span>
              <a class="row__link" href={item.href} lang={"lang" in item ? (item.lang as string) : undefined}>{item.title}</a>
            </li>
          ))
        }
      </ul>
      <p class="mt-8"><a class="text-link" href={plates.writing.moreHref}>{plates.writing.moreLabel}</a></p>
    </Plate>

    <Plate id="podium" number="04" state title={plates.talks.title} feature="container-type: scroll-state" baseline="obmedzená dostupnosť">
      <p slot="margin" class="podium-note">Popis tabule je sám ukážkou: na širšej obrazovke sa pripne a prepne na <code>stuck: top</code>.</p>
      {plates.talks.text && <p class="lead">{plates.talks.text}</p>}
      <ul class="rows mt-8">
        {
          plates.talks.items.map((item, i) => (
            <li class="row row--talk" data-reveal style={`--reveal-i: ${i}`}>
              <span class="row__meta"><time datetime={item.date}>{monthYear(item.date)}</time></span>
              <span class="row__event">{item.event}{item.place !== site.company.city && <span class="row__place"> · {item.place}</span>}</span>
              <span class="row__topic">{item.title}</span>
            </li>
          ))
        }
      </ul>
    </Plate>

    <Plate id="farba" number="05" title={plates.color.title} feature="oklch() + <canvas>" baseline="široko dostupné">
      <p slot="margin" class="podium-note">Jediná výnimka z „najprv CSS“: 2&nbsp;kB WebGL. Bez neho tu ostane CSS gradient v&nbsp;<code>oklch</code>.</p>
      <p class="lead">{plates.color.text}</p>
      <div class="mt-8"><GamutPlate /></div>
      <p class="mt-8"><a class="text-link" href={plates.color.href}>{plates.color.linkLabel}</a></p>
    </Plate>

    <Plate id="nastroje" number="06" title={plates.tools.title} feature="@supports" baseline="široko dostupné">
      <style is:inline set:html={supportsCss}></style>
      <table class="supports">
        <caption>Vlastnosti tohto webu a váš prehliadač – zisťuje to <code>@supports</code>, bez JavaScriptu</caption>
        <thead>
          <tr><th scope="col">Vlastnosť</th><th scope="col">Kde</th><th scope="col">Váš prehliadač</th></tr>
        </thead>
        <tbody>
          {
            supports.map((f) => (
              <tr class="support" data-f={f.id}>
                <th scope="row"><code>{f.label}</code></th>
                <td>{f.where}</td>
                <td><span class="support__yes">áno</span><span class="support__no">nie – {f.no}</span></td>
              </tr>
            ))
          }
        </tbody>
      </table>
      <ul class="tools">
        {
          plates.tools.items.map((tool) => (
            <li class="tool">
              <p class="tool__kind">{tool.kind}</p>
              <h3 class="tool__name">
                <a href={withBase(tool.href)} class="tool__link">{tool.name}</a>
              </h3>
              <p class="tool__text">{tool.text}</p>
            </li>
          ))
        }
      </ul>
    </Plate>

    <Colophon />

    <Closing />
  </main>
  <SiteFooter />
</BaseLayout>

<style>
  .page {
    max-inline-size: 90rem;
    margin-inline: auto;
    padding-inline: clamp(1rem, 4vw, 3rem);
    /* The hero name bleeds into the margin on purpose; never a horizontal
       scrollbar (clip, not hidden: sticky plates keep working). */
    overflow-x: clip;
  }

  /* Obsah – Sutnar-style index: numbers carry the rhythm. */
  .contents {
    padding-block: clamp(2.5rem, 6vw, 4.5rem);
    border-block-start: 1px solid var(--color-border-strong);
  }

  .contents__title {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0;
    color: var(--color-primary);
  }

  .contents__list {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(10rem, 1fr));
    gap: 0 1.5rem;
    margin-block-start: 1rem;
    list-style: none;
    padding: 0;
  }

  .contents__link {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    min-block-size: 2.75rem;
    padding-block: 0.6rem;
    border-block-end: 1px solid var(--color-border);
    font-family: var(--font-heading);
    font-size: 1.25rem;
    font-variation-settings: "wdth" 112;
    font-weight: 600;
    color: var(--color-foreground);
    text-decoration: none;
  }

  .contents__link:hover,
  .contents__link:focus-visible {
    color: var(--color-primary);
  }

  .contents__no {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 400;
    color: var(--color-subtle);
  }

  .lead {
    max-inline-size: 62ch;
    margin-block-start: 1.5rem;
    font-size: 1.0625rem;
    line-height: 1.7;
    color: var(--color-muted);
    text-wrap: pretty;
  }

  .text-link,
  .row__link,
  .tool__link {
    color: var(--color-foreground);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.22em;
    transition:
      color var(--duration-fast) var(--ease-set),
      text-decoration-thickness var(--duration-fast) var(--ease-set);
  }

  .text-link {
    display: inline-flex;
    align-items: center;
    min-block-size: 2.75rem;
    font-family: var(--font-mono);
    font-size: 0.875rem;
  }

  .text-link::after {
    content: "→" / "";
    margin-inline-start: 0.5em;
    text-decoration: none;
  }

  .text-link:hover,
  .text-link:focus-visible,
  .row__link:hover,
  .row__link:focus-visible,
  .tool__link:hover,
  .tool__link:focus-visible {
    color: var(--color-primary);
    text-decoration-thickness: 2px;
  }

  /* Tab. 01 */
  .system-stats {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem 3rem;
    margin-block-start: 2rem;
  }

  .stat {
    display: block;
    font-family: var(--font-heading);
    font-size: clamp(3.5rem, 9vw, 7rem);
    font-variation-settings: "wdth" 150;
    font-weight: 800;
    line-height: 0.9;
    font-variant-numeric: tabular-nums;
  }

  .stat__label {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--color-muted);
  }

  /* Tab. 02 – services stacked like cascade layers: later layers win, so
     they sit on top and step to the right. */
  .layers__decl {
    margin-block-start: 1.5rem;
    font-size: 0.875rem;
    color: var(--color-muted);
  }

  .layers {
    display: grid;
    gap: 1rem;
    margin-block-start: 1.5rem;
    padding: 0;
    list-style: none;
  }

  .layer {
    position: relative;
    z-index: var(--i);
    max-inline-size: 36rem;
    padding: 1.5rem;
    background: var(--color-surface-elevated);
    /* Width and style only – the colour comes from the cascade layers. */
    border-width: 1px;
    border-style: solid;
  }

  .layer__name {
    font-size: 0.75rem;
    color: var(--color-primary);
  }

  .layer__title {
    margin-block-start: 0.5rem;
    font-size: clamp(1.375rem, 2.5vw, 1.875rem);
    font-variation-settings: "wdth" 110;
    font-weight: 700;
    line-height: 1.1;
  }

  .layers__note {
    max-inline-size: 62ch;
    margin-block-start: 0.75rem;
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--color-muted);
  }

  .layer__winner {
    margin-block-start: 0.75rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--color-muted);
  }

  .layer__winner-value::after {
    content: var(--winner);
    color: var(--color-primary);
  }

  /* Tab. 06 – support table */
  .supports {
    inline-size: 100%;
    margin-block-start: 2rem;
    border-collapse: collapse;
    font-size: 0.9375rem;
  }

  .supports caption {
    margin-block-end: 0.75rem;
    text-align: start;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--color-muted);
  }

  .supports :is(th, td) {
    padding-block: 0.6rem;
    padding-inline-end: 1rem;
    border-block-end: 1px solid var(--color-border);
    text-align: start;
    vertical-align: baseline;
  }

  .supports thead th {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 400;
    color: var(--color-subtle);
  }

  .support__yes {
    display: none;
    color: var(--color-success);
    font-weight: 600;
  }

  .support__no {
    color: var(--color-muted);
  }

  .layer__text {
    margin-block-start: 0.6rem;
    line-height: 1.65;
    color: var(--color-muted);
  }

  @media (min-width: 48rem) {
    .layers {
      gap: 0;
    }

    .layer {
      margin-inline-start: calc(var(--i) * clamp(2rem, 6vw, 6rem));
    }

    .layer + .layer {
      margin-block-start: -1.25rem;
    }
  }

  /* Tab. 03 + 04 – rows */
  .rows {
    margin-block-start: 1.5rem;
    padding: 0;
    list-style: none;
    border-block-start: 1px solid var(--color-border);
  }

  .row {
    display: grid;
    grid-template-columns: 5.5rem minmax(0, 1fr);
    gap: 0.25rem 1rem;
    align-items: baseline;
    padding-block: 1rem;
    border-block-end: 1px solid var(--color-border);
  }

  .row__meta {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--color-subtle);
  }

  .row__link {
    font-family: var(--font-heading);
    font-size: clamp(1.25rem, 2.6vw, 1.875rem);
    font-variation-settings: "wdth" 105;
    font-weight: 600;
    line-height: 1.15;
  }

  .row--talk .row__event {
    font-family: var(--font-heading);
    font-size: clamp(1.25rem, 2.6vw, 1.75rem);
    font-variation-settings: "wdth" 120;
    font-weight: 700;
    line-height: 1.15;
  }

  .row__place {
    font-weight: 400;
    color: var(--color-muted);
  }

  .row__topic {
    grid-column: 2;
    color: var(--color-muted);
    line-height: 1.55;
  }

  .podium-note {
    flex-basis: 100%;
    max-inline-size: 15rem;
    margin-block-start: 0.5rem;
    color: var(--color-muted);
    line-height: 1.55;
  }

  /* Tab. 06 */
  .tools {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
    gap: 1.5rem;
    margin-block-start: 2rem;
    padding: 0;
    list-style: none;
  }

  .tool {
    padding-block-start: 1rem;
    border-block-start: 2px solid var(--color-foreground);
  }

  .tool__kind {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--color-primary);
  }

  .tool__name {
    margin-block-start: 0.5rem;
    font-family: var(--font-mono);
    font-size: 1.25rem;
    font-weight: 600;
    letter-spacing: 0;
  }

  .tool__link {
    display: inline-flex;
    min-block-size: 2.75rem;
    align-items: center;
  }

  .tool__text {
    margin-block-start: 0.25rem;
    line-height: 1.65;
    color: var(--color-muted);
  }

</style>
