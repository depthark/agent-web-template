---
import BaseLayout from "@/layouts/BaseLayout.astro";
import SiteHeader from "@/components/SiteHeader.astro";
import SiteFooter from "@/components/SiteFooter.astro";
import SectionIntro from "@/components/SectionIntro.astro";
import Button from "@/components/ui/Button.astro";
import Plate from "@/components/specimen/Plate.astro";
import { site } from "@/data/site";
import { withBase } from "@/lib/navigation";

const page = site.contactPage;
// Same recipients as functions/api/inquiry.ts (CMS list, else all contacts).
const inquiryTo = page.form.recipients?.length
  ? page.form.recipients
  : site.company.contacts.map((person) => person.email);
const topics = page.form.topics ?? [];
const social = site.social as Record<string, string>;
// Short, unbreakable link text: "in/lukas-chylik", "luko248", "lukaschylik.dev/blog".
const host = (url: string) =>
  url
    .replace(/^https?:\/\/(www\.)?/, "")
    .replace(/^(linkedin\.com|github\.com)\//, "")
    .replace(/\/$/, "");
const elsewhere = [
  { label: "LinkedIn", href: social.linkedin },
  { label: "GitHub", href: social.github },
  { label: "Blog", href: site.home.plates.writing.moreHref },
]
  .filter((link): link is { label: string; href: string } => Boolean(link.href))
  .map((link) => ({ ...link, text: host(link.href) }));
---

<BaseLayout
  title={page.seo.title}
  description={page.seo.description}
  keywords={page.seo.keywords}
  pageType="ContactPage"
  pathname="/kontakt/"
  breadcrumbs={[
    { name: "Úvod", href: "/" },
    { name: "Kontakt", href: "/kontakt/" },
  ]}
>
  <SiteHeader pathname={Astro.url.pathname} />
  <main id="main" class="mx-auto max-w-[90rem] px-[clamp(1rem,4vw,3rem)] py-12 sm:py-16 lg:py-24">
    <SectionIntro level={1} eyebrow="Kontakt" title={page.title} text={page.text} />

    <Plate id="poptavka" number="07" title="Správa" feature=":user-invalid · :has() · subgrid" baseline="široko dostupné" class="mt-12 sm:mt-16">
      <div slot="margin" class="where">
        <p class="where__title">Kde ma nájdete</p>
        <dl class="where__list">
          <div>
            <dt>Mesto</dt>
            <dd>{site.company.city}</dd>
          </div>
          {
            elsewhere.map((link) => (
              <div>
                <dt>{link.label}</dt>
                <dd>
                  <a href={link.href} rel="me" class="where__link">{link.text}</a>
                </dd>
              </div>
            ))
          }
        </dl>
      </div>
      <div class="inquiry-panel mt-8 max-w-3xl">
        <p id="inquiry-help" class="leading-7 text-muted">
          Pár údajov a správa mi príde rovno do <span class="whitespace-nowrap">e-mailu</span>. Formulár sa kontroluje sám, bez JavaScriptu – chyby uvidíte, až keď pole opustíte.
        </p>

        <form
          class="inquiry mt-6 grid gap-5"
          action={withBase("/api/inquiry")}
          method="post"
          aria-describedby="inquiry-help inquiry-required"
          data-inquiry
          data-to={inquiryTo[0]}
          data-cc={inquiryTo.slice(1).join(",")}
        >
          <p id="inquiry-required" class="text-sm text-muted">Polia označené <span class="inquiry__mark" aria-hidden="true">*</span> sú povinné.</p>
          <div class="inquiry__row">
            <label class="inquiry__field">
              <span>Meno a priezvisko <span class="inquiry__mark" aria-hidden="true">*</span></span>
              <input name="name" type="text" autocomplete="name" required minlength="2" maxlength="120" placeholder="Jana Nováková" aria-describedby="inquiry-name-error" />
              <span class="inquiry__error" id="inquiry-name-error">Vyplňte prosím meno.</span>
            </label>
            <label class="inquiry__field">
              <span>Telefón <small>(nepovinné)</small></span>
              <input name="phone" type="tel" autocomplete="tel" inputmode="tel" maxlength="40" pattern="[+0-9 \(\)\-]{9,20}" placeholder="+421 900 123 456" aria-describedby="inquiry-phone-error" />
              <span class="inquiry__error" id="inquiry-phone-error">Zadajte telefón v tvare +421 900 123 456.</span>
            </label>
          </div>
          <label class="inquiry__field">
            <span>E-mail <span class="inquiry__mark" aria-hidden="true">*</span></span>
            <input name="email" type="email" autocomplete="email" required maxlength="200" pattern="[^@\s]+@[^@\s]+\.[^@\s]{2,}" placeholder="jana@example.com" aria-describedby="inquiry-email-error" />
            <span class="inquiry__error" id="inquiry-email-error">Zadajte platný e-mail, napr. jana@example.com.</span>
          </label>
          {
            topics.length > 0 && (
              <label class="inquiry__field">
                <span>Čo riešite <small>(nepovinné)</small></span>
                <select name="topic">
                  <option value="">Vyberte</option>
                  {topics.map((topic) => <option>{topic}</option>)}
                </select>
              </label>
            )
          }
          <label class="inquiry__trap" aria-hidden="true">
            Nevypĺňajte <input name="website" type="text" tabindex="-1" autocomplete="off" />
          </label>
          <label class="inquiry__field">
            <span>Správa <span class="inquiry__mark" aria-hidden="true">*</span></span>
            <textarea name="message" rows="5" required minlength="10" maxlength="4000" placeholder="Stručne opíšte, čo potrebujete a dokedy." aria-describedby="inquiry-message-error"></textarea>
            <span class="inquiry__error" id="inquiry-message-error">Napíšte prosím aspoň pár slov (min. 10 znakov).</span>
          </label>
          <div class="flex flex-wrap items-center gap-4">
            <Button as="button" type="submit" variant="primary" size="lg">Odoslať správu</Button>
            <p class="text-sm text-muted" role="status" aria-live="polite" data-inquiry-status></p>
          </div>
        </form>

        <div id="odeslano" class="inquiry__success mt-6" role="status" tabindex="-1" data-inquiry-success>
          <svg class="inquiry__success-icon" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="12" cy="12" r="9.5" /><path d="M8 12.5l2.7 2.7L16.2 9.5" />
          </svg>
          <div>
            <p class="inquiry__success-title">{page.form.successTitle}</p>
            <p class="mt-1 leading-7">{page.form.successText}</p>
            <button type="button" class="inquiry__again" data-inquiry-again>Napísať ďalšiu správu</button>
          </div>
        </div>
      </div>
    </Plate>
  </main>
  <SiteFooter />
</BaseLayout>

<style>
  .where {
    flex-basis: 100%;
    margin-block-start: 1rem;
  }

  .where__title {
    font-weight: 600;
    color: var(--color-primary);
  }

  .where__list {
    display: grid;
    gap: 0.6rem;
    margin-block-start: 0.5rem;
  }

  .where__list dt {
    color: var(--color-subtle);
  }

  .where__list dd {
    color: var(--color-foreground);
  }

  .where__link {
    display: inline-flex;
    align-items: center;
    min-block-size: 1.5rem;
    white-space: nowrap;
    color: var(--color-foreground);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.22em;
  }

  .where__link:hover,
  .where__link:focus-visible {
    color: var(--color-primary);
    text-decoration-thickness: 2px;
  }

  .inquiry__field {
    display: grid;
    align-content: start;
    gap: calc(var(--spacing) * 2);
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--color-foreground);
  }

  /* Fields side by side share their rows (label / input / error) through
     subgrid, so an error under one field never pushes the other out of line. */
  .inquiry__row {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    column-gap: calc(var(--spacing) * 5);
    row-gap: calc(var(--spacing) * 2);
  }

  .inquiry__row > .inquiry__field {
    grid-row: span 3;
    grid-template-rows: subgrid;
    gap: inherit;
  }

  .inquiry__row > .inquiry__field + .inquiry__field {
    margin-top: calc(var(--spacing) * 3);
  }

  @media (min-width: 640px) {
    .inquiry__row {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .inquiry__row > .inquiry__field + .inquiry__field {
      margin-top: 0;
    }
  }

  .inquiry__field small {
    font-weight: 400;
    color: var(--color-subtle);
  }

  .inquiry__field :is(input, select, textarea) {
    width: 100%;
    min-height: 3rem;
    padding: calc(var(--spacing) * 3) calc(var(--spacing) * 4);
    border: 1px solid var(--color-border-strong);
    border-radius: 0.25rem;
    background: var(--color-background);
    color: var(--color-foreground);
    font: inherit;
    font-size: 1rem;
    font-weight: 400;
    transition: border-color var(--duration-fast) var(--ease-standard);
  }

  .inquiry__trap {
    position: absolute;
    left: -10000px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  .inquiry__field textarea {
    resize: vertical;
  }

  .inquiry__field :is(input, select, textarea):focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 1px;
    border-color: var(--color-primary);
  }

  .inquiry__mark {
    color: var(--color-danger);
  }

  .inquiry__error {
    display: none;
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--color-danger);
  }

  /* Validation states show only after the visitor touched the field (or tried
     to submit) – :user-valid / :user-invalid, no JS. Empty optional fields
     stay neutral. */
  .inquiry__field :is(input, textarea):user-invalid {
    border-color: var(--color-danger);
    box-shadow: 0 0 0 1px var(--color-danger);
    background: color-mix(in oklch, var(--color-danger-soft) 55%, var(--color-background));
  }

  .inquiry__field:has(:user-invalid) .inquiry__error {
    display: block;
  }

  .inquiry__field :is(input, textarea):user-valid:not(:placeholder-shown),
  .inquiry__field select:user-valid:has(option:checked:not([value=""])) {
    border-color: var(--color-success);
    box-shadow: 0 0 0 1px var(--color-success);
  }

  .inquiry__field :is(input, textarea):user-invalid:focus-visible {
    outline-color: var(--color-danger);
  }

  .inquiry__field :is(input, textarea):user-valid:not(:placeholder-shown):focus-visible {
    outline-color: var(--color-success);
  }

  .inquiry__field ::placeholder {
    color: var(--color-subtle);
  }

  .inquiry__success {
    display: flex;
    gap: calc(var(--spacing) * 4);
    padding: calc(var(--spacing) * 5);
    border: 1px solid var(--color-success);
    border-radius: 0.25rem;
    background: var(--color-success-soft);
    color: var(--color-foreground);
  }

  .inquiry[hidden] {
    display: none;
  }

  /* Shown by the page script after sending ([data-shown]); without JS the
     form posts to /api/inquiry, which redirects back to #odeslano. (Not the
     hidden attribute: Tailwind's preflight hides it with a layered
     !important that :target cannot override.) */
  .inquiry__success:not([data-shown], :target) {
    display: none;
  }

  section:has(.inquiry__success:target) .inquiry {
    display: none;
  }

  .inquiry__success:focus-visible {
    outline: 2px solid var(--color-success);
    outline-offset: 2px;
  }

  .inquiry__success-icon {
    flex: none;
    color: var(--color-success);
  }

  .inquiry__success-title {
    font-weight: 600;
    font-size: 1.125rem;
  }

  .inquiry__again {
    margin-top: calc(var(--spacing) * 3);
    min-height: 2.75rem;
    padding: 0;
    border: 0;
    background: none;
    color: var(--color-primary);
    font: inherit;
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 3px;
    cursor: pointer;
  }
</style>

<script>
  // Sends the inquiry through /api/inquiry (Resend). If the endpoint is not
  // available (GitHub Pages, missing config, outage) it falls back to a
  // prepared mailto: e-mail; without JS the native mailto form posts.
  // Validation is native (required, pattern, minlength) and styled in CSS
  // with :user-valid / :user-invalid.
  const form = document.querySelector<HTMLFormElement>("[data-inquiry]");
  const status = document.querySelector<HTMLElement>("[data-inquiry-status]");
  const success = document.querySelector<HTMLElement>("[data-inquiry-success]");
  const again = document.querySelector<HTMLButtonElement>("[data-inquiry-again]");
  const submit = form?.querySelector<HTMLButtonElement>("button[type=submit]");
  let startedAt = Date.now();
  const endpoint = `${import.meta.env.BASE_URL.replace(/\/$/, "")}/api/inquiry`;

  const setStatus = (text: string) => {
    if (status) status.textContent = text;
  };

  const showSuccess = () => {
    if (!form || !success) return;
    form.reset();
    form.hidden = true;
    success.dataset.shown = "";
    success.focus();
  };

  if (new URLSearchParams(location.search).has("chyba")) {
    setStatus("Správu sa nepodarilo odoslať. Skúste to prosím znova.");
  }

  again?.addEventListener("click", () => {
    if (!form || !success) return;
    delete success.dataset.shown;
    // Leave the no-JS #odeslano state (:target) without a new history entry.
    if (location.hash === "#odeslano") location.replace("#poptavka");
    form.hidden = false;
    setStatus("");
    startedAt = Date.now();
    form.querySelector<HTMLInputElement>("input[name=name]")?.focus();
  });

  const openMailto = (data: FormData) => {
    if (!form?.dataset.to) {
      setStatus("Odoslanie z webu teraz nefunguje. Skúste to prosím neskôr.");
      return;
    }
    const value = (key: string) => String(data.get(key) ?? "").trim();
    const topic = value("topic");
    const subject = `Správa z webu${topic ? ` – ${topic}` : ""}`;
    const details = [
      `Meno: ${value("name")}`,
      `E-mail: ${value("email")}`,
      ...(value("phone") ? [`Telefón: ${value("phone")}`] : []),
      ...(topic ? [`Téma: ${topic}`] : []),
    ];
    const body = [value("message"), "", ...details].join("\n");
    const cc = form?.dataset.cc ? `&cc=${encodeURIComponent(form.dataset.cc)}` : "";
    window.location.href = `mailto:${form?.dataset.to}?subject=${encodeURIComponent(subject)}${cc}&body=${encodeURIComponent(body)}`;
    setStatus("Odoslanie z webu teraz nefunguje – otváram váš e-mailový program.");
  };

  form?.addEventListener("submit", async (event) => {
    event.preventDefault();
    if (!form.reportValidity()) return;
    const data = new FormData(form);
    if (submit) submit.disabled = true;
    setStatus("Odosielam…");
    try {
      const response = await fetch(endpoint, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ ...Object.fromEntries(data), elapsed: Date.now() - startedAt }),
      });
      const result = (await response.json().catch(() => ({}))) as { error?: string };
      if (response.ok) {
        setStatus("");
        showSuccess();
      } else if (response.status === 400 && result.error) {
        setStatus(result.error);
      } else {
        openMailto(data);
      }
    } catch {
      openMailto(data);
    } finally {
      if (submit) submit.disabled = false;
    }
  });
</script>
