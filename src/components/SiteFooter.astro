---
/**
 * The Tiráž already ends the story; the footer is one imprint line in mono:
 * name · city · elsewhere · ©. Always dark: text-accent, never text-primary.
 */
import { site } from "@/data/site";

const social = site.social as Record<string, string>;
const links = [
  { label: "LinkedIn", href: social.linkedin },
  { label: "GitHub", href: social.github },
  { label: "Blog", href: site.home.plates.writing.moreHref },
].filter((link) => link.href);
---

<footer class="bg-footer-bg text-footer-text" aria-labelledby="site-footer-heading">
  <h2 id="site-footer-heading" class="sr-only">Pätička stránky</h2>
  <div class="imprint mx-auto max-w-[90rem] px-[clamp(1rem,4vw,3rem)]">
    <p class="imprint__name">{site.name}</p>
    <p>{site.tagline} · {site.company.city}</p>
    {
      links.length > 0 && (
        <ul class="imprint__links">
          {links.map((link) => (
            <li>
              <a href={link.href} rel="me" class="imprint__link">{link.label}</a>
            </li>
          ))}
        </ul>
      )
    }
    <p class="imprint__copy">© {new Date().getFullYear()}</p>
  </div>
</footer>

<style>
  .imprint {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.25rem 1.5rem;
    padding-block: 1.5rem;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
  }

  .imprint__name {
    font-family: var(--font-heading);
    font-size: 1.125rem;
    font-variation-settings: "wdth" 135;
    font-weight: 800;
    color: var(--color-white);
  }

  .imprint__links {
    display: flex;
    flex-wrap: wrap;
    gap: 0 1.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .imprint__link {
    display: inline-flex;
    align-items: center;
    min-block-size: 2.75rem;
    color: var(--color-white);
    text-decoration: underline;
    text-decoration-color: oklch(1 0 0 / 0.3);
    text-underline-offset: 0.25em;
  }

  .imprint__link:hover,
  .imprint__link:focus-visible {
    color: var(--color-accent);
    text-decoration-color: currentColor;
  }

  /* Vermilion is too dark on the footer: the focus ring uses the light tint. */
  .imprint__link:focus-visible {
    outline-color: var(--color-accent);
  }

  .imprint__copy {
    margin-inline-start: auto;
  }
</style>
