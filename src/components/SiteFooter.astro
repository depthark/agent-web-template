---
import { site } from "@/data/site";
import { withBase } from "@/lib/navigation";

const social = site.social as Record<string, string>;
const links = [
  { label: "LinkedIn", href: social.linkedin },
  { label: "GitHub", href: social.github },
  { label: "Blog", href: site.home.plates.writing.moreHref },
].filter((link) => link.href);
---

<!-- Always dark: text-accent (light tint) here, never text-primary. -->
<footer class="bg-footer-bg py-12 text-footer-text sm:py-16" aria-labelledby="site-footer-heading">
  <h2 id="site-footer-heading" class="sr-only">Pätička stránky</h2>
  <div class="mx-auto grid max-w-[90rem] gap-10 px-[clamp(1rem,4vw,3rem)] md:grid-cols-[1.4fr_1fr_1fr]">
    <div>
      <p class="footer-name">{site.name}</p>
      <p class="mt-3 max-w-sm text-sm leading-6">{site.tagline} · {site.company.city}</p>
    </div>

    <div>
      <p class="footer-label">Stránky</p>
      <ul class="mt-3 list-none space-y-1 p-0">
        {
          site.nav.map((item) => (
            <li>
              <a href={withBase(item.href)} class="footer-link">{item.label}</a>
            </li>
          ))
        }
      </ul>
    </div>

    {
      links.length > 0 && (
        <div>
          <p class="footer-label">Inde</p>
          <ul class="mt-3 list-none space-y-1 p-0">
            {links.map((link) => (
              <li>
                <a href={link.href} class="footer-link" rel="me">
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      )
    }
  </div>

  <p class="mx-auto mt-12 max-w-[90rem] border-t border-white/10 px-[clamp(1rem,4vw,3rem)] pt-6 text-xs leading-6">
    © {new Date().getFullYear()} {site.name}
  </p>
</footer>

<style>
  .footer-name {
    font-family: var(--font-heading);
    font-size: clamp(1.75rem, 4vw, 2.75rem);
    font-variation-settings: "wdth" 150;
    font-weight: 800;
    line-height: 1;
    color: var(--color-white);
  }

  .footer-label {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--color-accent);
  }

  .footer-link {
    display: inline-flex;
    align-items: center;
    min-block-size: 2.75rem;
    color: var(--color-white);
    text-decoration: underline;
    text-decoration-color: oklch(1 0 0 / 0.3);
    text-underline-offset: 0.25em;
  }

  .footer-link:hover,
  .footer-link:focus-visible {
    color: var(--color-accent);
    text-decoration-color: currentColor;
  }

  /* Vermilion is too dark on the footer: the focus ring uses the light tint. */
  .footer-link:focus-visible {
    outline-color: var(--color-accent);
  }
</style>
