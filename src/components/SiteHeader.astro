---
import { site } from "@/data/site";
import { withBase } from "@/lib/navigation";
import MobileMenu from "./MobileMenu.astro";
import ThemeToggle from "./ThemeToggle.astro";

export interface Props {
  pathname: string;
}

const { pathname } = Astro.props;
const activePath =
  pathname === "/" ? "/" : pathname.endsWith("/") ? pathname : `${pathname}/`;
---

<!-- Typographic wordmark (the name is the brand); the header persists across
     cross-document view transitions. -->
<header class="site-header glass sticky top-0 z-[var(--z-header)] h-(--header-height) border-b border-border">
  <div class="mx-auto flex h-full max-w-[90rem] items-center gap-3 px-[clamp(1rem,4vw,3rem)] lg:gap-8">
    <a href={withBase("/")} class="wordmark flex min-h-11 min-w-0 flex-col justify-center no-underline">
      <span class="wordmark__name">{site.name}</span>
      <span class="wordmark__tag hidden min-[400px]:block">{site.tagline}</span>
      <span class="sr-only"> – úvodná stránka</span>
    </a>

    <nav class="ml-auto hidden items-center gap-6 lg:flex xl:gap-8" aria-label="Hlavná navigácia">
      {
        site.nav.map((item) => {
          const isActive = activePath === item.href;
          return (
            <a
              href={withBase(item.href)}
              aria-current={isActive ? "page" : undefined}
              class:list={[
                "nav-link inline-flex min-h-11 items-center whitespace-nowrap no-underline",
                isActive ? "text-foreground" : "text-muted hover:text-foreground",
              ]}
            >
              {item.label}
            </a>
          );
        })
      }
      <ThemeToggle />
      <a
        href={withBase("/kontakt/#poptavka")}
        class="inline-flex min-h-11 items-center whitespace-nowrap rounded-md bg-action px-5 text-sm font-semibold text-on-action no-underline transition-colors duration-fast ease-standard hover:bg-action-hover"
      >
        Napísať
      </a>
    </nav>

    <div class="ml-auto flex shrink-0 items-center gap-2 lg:hidden">
      <ThemeToggle />
      <MobileMenu pathname={pathname} />
    </div>
  </div>
</header>

<style>
  .site-header {
    view-transition-name: site-header;
  }

  .wordmark__name {
    font-family: var(--font-heading);
    font-size: 1.25rem;
    font-variation-settings: "wdth" 135;
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.01em;
    color: var(--color-foreground);
  }

  .wordmark__tag {
    margin-block-start: 0.3rem;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    line-height: 1;
    color: var(--color-muted);
  }

  .nav-link {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    transition: color var(--duration-fast) var(--ease-set);
  }

  .nav-link[aria-current="page"] {
    text-decoration: underline;
    text-decoration-color: var(--color-primary);
    text-decoration-thickness: 2px;
    text-underline-offset: 0.45em;
  }
</style>
