# Public (build time) ---------------------------------------------------------
PUBLIC_SITE_URL=https://www.example.cz

# Cloudflare Pages secrets (runtime, functions/) – set in the dashboard as
# type "Secret" (wrangler.toml exists, so build variables are not read) ------
# GITHUB_CLIENT_ID=…            GitHub OAuth app for the CMS login
# GITHUB_CLIENT_SECRET=…
# RESEND_API_KEY=…              contact form e-mails (functions/api/inquiry.ts), "Sending access" only
# INQUIRY_FROM=…                optional, default "<site name> <web@<domain>>"
# INQUIRY_TO=…                  optional comma-separated recipients (default: CMS → Kontakt → Formulář)
